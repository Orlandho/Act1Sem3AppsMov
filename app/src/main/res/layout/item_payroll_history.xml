<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/CardModern"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Encabezado del Item: Folio y Fecha -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvItemFolio"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="FOLIO: PAY-2026-4821"
                android:textColor="@color/primary"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="FOLIO: PAY-2026-4821" />

            <TextView
                android:id="@+id/tvItemDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="17 Sep 2026, 11:20 AM"
                android:textColor="@color/text_tertiary"
                android:textSize="11sp"
                tools:text="17 Sep 2026, 11:20 AM" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="8dp"
            android:background="@color/border_subtle" />

        <!-- Datos del Colaborador -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvItemFullName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="Carlos Eduardo Mendoza" />

                <TextView
                    android:id="@+id/tvItemCode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    tools:text="ID: EMP-2026-88" />
            </LinearLayout>

            <!-- Monto Neto Destacado -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NETO A COBRAR"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvItemNetPay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/secondary_dark"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:text="$ 1,868.15" />
            </LinearLayout>
        </LinearLayout>

        <!-- Badges de Estado: Rango y Horas Extras -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvItemRank"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_badge"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:text="Senior Specialist"
                android:textColor="@color/primary"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="Senior Specialist" />

            <TextView
                android:id="@+id/tvItemOvertime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_pill_badge_amber"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:text="⚡ +8.0h extras"
                android:textColor="@color/on_accent_amber"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="⚡ +8.0h extras" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Botones de Acción Rápida -->
            <!-- Ver Boleta -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnItemView"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:contentDescription="Ver boleta"
                android:text="📄"
                android:textSize="14sp"
                app:iconTint="@color/primary" />

            <!-- Editar -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnItemEdit"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:contentDescription="Editar liquidación"
                android:text="✏️"
                android:textSize="14sp"
                app:iconTint="@color/secondary" />

            <!-- Eliminar -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnItemDelete"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:contentDescription="Eliminar liquidación"
                android:text="🗑️"
                android:textSize="14sp"
                app:iconTint="@color/danger" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
