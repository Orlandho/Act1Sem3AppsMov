<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    tools:context=".VoucherActivity">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Encabezado con Gradiente -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_gradient_header"
                android:elevation="6dp"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                android:paddingTop="48dp"
                android:paddingBottom="36dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Comprobante Digital"
                        android:textColor="@color/white"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill_badge"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="4dp"
                        android:text="Paso 3 de 3"
                        android:textColor="@color/primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Boleta oficial generada con validez interna y sello de auditoría"
                    android:textColor="#E0E7FF"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Tarjeta Estilo Voucher / Ticket Digital -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-20dp"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingBottom="28dp">

                <com.google.android.material.card.MaterialCardView
                    style="@style/CardModern"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardElevation="5dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <!-- Encabezado del Ticket -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="SMARTPAYROLL ENTERPRISE"
                                    android:textColor="@color/primary"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvVoucherFolio"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="FOLIO: PAY-2026-X839"
                                    android:textColor="@color/text_primary"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvIssueDate"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Fecha: 03 Sep 2026, 08:50 AM"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="11sp" />

                                <TextView
                                    android:id="@+id/tvVoucherSyncStatus"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:background="@drawable/bg_pill_badge_emerald"
                                    android:paddingHorizontal="8dp"
                                    android:paddingVertical="2dp"
                                    android:text="🟢 Sincronizado en MySQL"
                                    android:textColor="@color/on_accent_emerald"
                                    android:textSize="10sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <!-- Sello de Aprobación Visual -->
                            <TextView
                                android:id="@+id/tvApprovedStamp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_stamp_approved"
                                android:text="✓ APROBADO\nAUDITADO"
                                android:textAlignment="center"
                                android:textColor="@color/secondary"
                                android:textSize="10sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Línea Divisoria Punteada -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="2dp"
                            android:layout_marginVertical="16dp"
                            android:background="@drawable/bg_dashed_line" />

                        <!-- Datos del Colaborador -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ficha del Colaborador"
                            android:textColor="@color/text_tertiary"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvVoucherFullName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Carlos Eduardo Mendoza Ramos"
                            android:textColor="@color/text_primary"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvVoucherCode"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="ID: EMP-2026-88"
                                android:textColor="@color/text_secondary"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/tvVoucherRank"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_pill_badge"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="2dp"
                                android:text="Senior Specialist"
                                android:textColor="@color/primary"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Línea Divisoria Punteada -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="2dp"
                            android:layout_marginVertical="16dp"
                            android:background="@drawable/bg_dashed_line" />

                        <!-- Tabla de Conceptos Liquidados -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Detalle de Conceptos"
                            android:textColor="@color/text_tertiary"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <!-- Fila: Horas Regulares -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvConceptRegularLabel"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Horas Regulares (40h x $35.50)"
                                android:textColor="@color/text_secondary"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/tvConceptRegularPay"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="$ 1,420.00"
                                android:textColor="@color/text_primary"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <!-- Fila: Horas Extras -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvConceptOvertimeLabel"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Horas Extras (8h x $53.25)"
                                android:textColor="@color/text_secondary"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/tvConceptOvertimePay"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="$ 426.00"
                                android:textColor="@color/text_primary"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <!-- Fila: Bono -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvConceptBonusLabel"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Incentivo / Bono (10%)"
                                android:textColor="@color/secondary"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/tvConceptBonusPay"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="+$ 184.60"
                                android:textColor="@color/secondary"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Fila: Deducciones Salud & Pensión -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Seguridad Social (Salud 4% + Pensión 4%)"
                                android:textColor="@color/danger"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/tvConceptDeductions"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="-$ 162.45"
                                android:textColor="@color/danger"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <!-- Línea Divisoria Punteada -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="2dp"
                            android:layout_marginVertical="16dp"
                            android:background="@drawable/bg_dashed_line" />

                        <!-- Fila Destacada: TOTAL NETO A PAGAR -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@color/secondary_light"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="12dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="NETO FINAL A COBRAR"
                                    android:textColor="@color/secondary_dark"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Depósito bancario programado"
                                    android:textColor="@color/secondary_dark"
                                    android:textSize="10sp" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/tvVoucherNetPay"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="$ 1,868.15"
                                android:textColor="@color/secondary_dark"
                                android:textSize="22sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:gravity="center"
                            android:text="Documento digital emitido por el sistema académico SmartPayroll Pro.\nConexión exitosa entre 3 formularios mediante Android Intents."
                            android:textColor="@color/text_tertiary"
                            android:textSize="10sp" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Botones de Acción de la Vista 3 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical">

                    <!-- Botón Descargar Boleta .txt (Storage Access Framework) -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDownloadReceipt"
                        style="@style/ButtonRounded"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="📥 Descargar Boleta (.txt)"
                        android:textSize="15sp"
                        app:backgroundTint="@color/primary" />

                    <!-- Botón Compartir Comprobante (Intent Implícito) -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnShareReceipt"
                        style="@style/ButtonRounded"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="8dp"
                        android:text="📲 Compartir Comprobante"
                        android:textSize="15sp"
                        app:backgroundTint="@color/secondary" />

                    <!-- Botón Retornar al inicio / Nuevo cálculo -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRestart"
                        style="@style/ButtonRounded.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="🔄 Nuevo Registro (Paso 1)"
                        android:textColor="@color/primary"
                        android:textSize="14sp" />

                    <!-- Botón Volver al Dashboard Central -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGoToDashboard"
                        style="@style/ButtonRounded.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="📊 Volver al Dashboard Central"
                        android:textColor="@color/primary_dark"
                        android:textSize="14sp" />

                    <!-- Botón Modificar Liquidación Completa -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEditPayroll"
                        style="@style/ButtonRounded.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="✏️ Modificar Liquidación Completa"
                        android:textColor="@color/primary"
                        android:textSize="14sp" />
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
